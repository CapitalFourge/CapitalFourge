# Capital Fourge - Environment Variables
# Copy to .env and fill in your values

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DB_PASSWORD=your_strong_postgres_password_here

# ─────────────────────────────────────────────────────────────
# JWT (generate with: openssl rand -base64 64)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_64_chars_base64_here

# ─────────────────────────────────────────────────────────────
# DATA COLLECTOR API KEY (generate with: openssl rand -hex 16)
# Must match in both portfolio-manager and data-collector
# ─────────────────────────────────────────────────────────────
DATA_COLLECTOR_API_KEY=your_32_char_hex_key_here

# ─────────────────────────────────────────────────────────────
# OPTIONAL: MongoDB (for historical market data)
# ─────────────────────────────────────────────────────────────
DB_MONGO_HOST=mongodb://mongo:27017
DB_MONGO_ROOT_PASSWORD=mongo_password_here

# ─────────────────────────────────────────────────────────────
# CADDY EMAIL (for Let's Encrypt notifications)
# ─────────────────────────────────────────────────────────────
CADDY_EMAIL=admin@capitalfourge.com