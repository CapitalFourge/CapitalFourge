# Capital Fourge - Caddy Reverse Proxy
# Auto HTTPS via Let's Encrypt, HTTP/2, HTTP/3

{
    admin off
    # Email for Let's Encrypt notifications (cambia por tu email real)
    email admin@capitalfourge.com
}

# API Backend (Spring Boot)
api.capitalfourge.com {
    reverse_proxy portfolio-manager:10000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}